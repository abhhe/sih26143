# =====================================================================
# SIH 2026 - Problem Statement 26143: Oil Spill Source Attribution
# Environment Configuration Template
# =====================================================================

# Execution Mode: DEMO (uses local sample files) or REAL (uses external APIs/datasets)
APP_MODE=DEMO

# Local Data Directories
DATA_DIR=data
SAR_DATA_DIR=data/sample_sar
CSIRO_DATA_DIR=data/sample_sar/csiro
METOCEAN_DATA_DIR=data/sample_metocean
AIS_DATA_DIR=data/sample_ais

# 1. Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 SAR
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here
CDSE_CLIENT_ID=cdse-public

# 2. Copernicus Climate Data Store (CDS) - ERA5 10m Wind
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_cds_api_key_here

# 3. Copernicus Marine Service (CMEMS) - Ocean Currents (uo, vo)
COPERNICUS_MARINE_USERNAME=your_cmems_username_here
COPERNICUS_MARINE_PASSWORD=your_cmems_password_here

# 4. AIS Trajectory Providers (Global Fishing Watch API)
GFW_API_URL=https://gateway.globalfishingwatch.org/v3
GFW_API_TOKEN=your_gfw_bearer_token_here

# Scientific Attribution Threshold (Default: 50.0 / 100)
DEFAULT_EVIDENCE_THRESHOLD=50.0
